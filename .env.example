PORT=3000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=catchup
JWT_SECRET=change_this_to_a_long_random_string

# Optional. With a key, the organizer "Draft event" box is written by Claude.
# Without one it still works using a built-in template.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5


# Face check-in: how close two faces must be to count as the same person (lower = stricter, 0.4 to 0.6 is sensible)
FACE_MATCH_THRESHOLD=0.5
